# ===========================================
# ROOT-LEVEL CONFIG (must be before sections)
# ===========================================

# Refresh interval (if schedule_times is commented out or empty)
interval_min = 60
timezone_offset = 8

# Fixed Schedule (Service will skip checks outside these times)
schedule_times = [
    "07:30",
    "18:00",
]

# RSS Feeds to monitor
rss_feeds = [
    # Tech
    "https://www.solidot.org/index.rss",
    "https://www.infoq.cn/feed",
    "https://www.v2ex.com/index.xml",
    "https://hackaday.com/feed/",
    "https://www.technologyreview.com/feed/",
    "https://36kr.com/feed",
    # Add your feeds here...
]

# Classification Categories for LLM (Array of Tables)
[[categories]]
name = "热点科技"
description = "人工智能、大模型、机器学习、Agent、前沿科技动态"

[[categories]]
name = "工程技术"
description = "编程语言、软件工程、开源项目、架构实践、开发工具"

[[categories]]
name = "生命科学"
description = "医学、生物技术、健康科技、科研进展"

[[categories]]
name = "科学"
description = "自然科学、物理、化学、天文、环境研究"

[[categories]]
name = "极客"
description = "黑客文化、效率工具、技术观点、社区热点"

[[categories]]
name = "数码"
description = "消费电子、硬件新品、芯片、终端设备"

[[categories]]
name = "游戏影音"
description = "游戏、影视、动漫、流媒体与相关产业新闻"

[[categories]]
name = "读书"
description = "读书方法、书籍推荐、知识管理与学习"

[[categories]]
name = "文娱"
description = "文化与娱乐动态、泛内容消费"

[[categories]]
name = "财经"
description = "商业公司、市场趋势、投融资与宏观经济"

[[categories]]
name = "政治"
description = "国际关系、政策法规、公共事务"

[[categories]]
name = "探索"
description = "太空探索、科学发现、技术边界拓展"

[[categories]]
name = "生活"
description = "生活方式、实用技巧、社会观察"

[[categories]]
name = "广告"
description = "推广内容、软文、营销信息（用于过滤）"

[[categories]]
name = "其他"
description = "无法归入以上分类的内容"

# ===========================================
# SECTIONS
# ===========================================

[nexus]
# Optional verified LAN route; preserves the HTTPS hostname and certificate check.
# connect_ip = "192.168.2.200"
# URL of your deployed Nexus backend (or local)
api_url = "http://127.0.0.1:8899"
# API Key must match server's NEXUS_KEY env var
auth_key = "your-secret-api-key"

[llm]
# OpenAI-compatible LLM endpoint
model = "google/gemma-4-26b-a4b-qat"
api_url = "http://127.0.0.1:1234/v1"
json_mode = "none"

[tts]
engine = "voxcpm"
process_isolation = true
# Match voice_worker.concurrency when benchmarking dedicated external-agent TTS.
# More Metal processes share one GPU; benchmark before increasing (maximum 4).
worker_max_processes = 1

[tts.voxcpm]
# Path to local VoxCPM model directory (required for aha)
model_path = "/path/to/VoxCPM1.5"
prompt_text = "我最近在研究 AI Agent 工作流，发现豆包 TTS 2.0 的效果真的非常 amazing。它可以 seamlessly 地在中文和 English 之间切换，听起来特别自然。"
prompt_wav_path = "file:///path/to/ref.wav"

[content_generation]
mode = "self_driven" # or "external_agent"; enabled=false alone remains legacy voice-only
# App-internal production lets Cortex run RSS/LLM generation locally.
# Set false only when an external scheduled agent owns content generation.
enabled = true

[curated_feed]
enabled = true
schedule_times = ["07:30", "18:00"]
source_group = "default"
max_items_per_cycle = 8
max_age_days = 90
min_quality_score = 5
prefer_proxy = true
article_audio_enabled = true
article_audio_max_items_per_cycle = 3
weekly_digest_enabled = true
weekly_digest_schedule_times = ["18:00"]
weekly_digest_min_items = 3
weekly_digest_max_items = 12

[loop_preferences]
enabled = true
schedule_times = ["07:30", "18:00"]
max_posts_per_cycle = 20
profile_context_max_chars = 3200

[voice_worker]
# Poll Nexus voice_jobs for generated or backfilled audio.
enabled = true
poll_interval_secs = 30
# Keep this aligned with tts.worker_max_processes to avoid leasing jobs just to wait.
concurrency = 1
max_jobs_per_tick = 1
lease_seconds = 1800
repair_missing_audio = true
repair_interval_secs = 600
repair_limit = 20

# ===========================================
# HOSTS (Array of Tables)
# Each host handles specific categories with a unique voice
# ===========================================

[[hosts]]
name = "Vivian"
# Voice file path (or model name if using other engines)
voice = "file:///path/to/audio/vivian.wav"
categories = ["热点科技", "工程技术", "生命科学", "科学", "极客"]

[[hosts]]
name = "灿灿"
voice = "file:///path/to/audio/cancan.wav"
categories = ["数码", "游戏影音"]

[[hosts]]
name = "小萌"
voice = "file:///path/to/audio/meng.wav"
categories = ["读书", "文娱"]

[[hosts]]
name = "小凡"
voice = "file:///path/to/audio/xiaofan.wav"
categories = ["财经", "政治"]

[[hosts]]
name = "小何"
voice = "file:///path/to/audio/xiaohe.wav"
categories = ["探索", "生活", "其他"]

# External editorial production: set mode = "external_agent" in the EXISTING
# [content_generation] section above (do not create a duplicate TOML table).
# Default mode = "self_driven" preserves the current local-LLM pipeline.
# External mode runs source ingestion/cache and voice_worker, never local drafting.
# Cortex source API: /api/agent/sources (uses the existing Cortex authentication).
# Mature Codex/Antigravity editor: skills/freshloop-content-agent/SKILL.md.
