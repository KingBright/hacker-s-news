#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Copy this file to the gitignored scripts/deploy.sh and fill in the target.
# Keep all release behavior in deploy_core.sh; this wrapper contains deployment
# coordinates only and must never reimplement build, upload, or verification.
export SERVER=""
export SSH_PORT=""
export APP_DIR=""
export DATA_DIR=""
export AUDIO_DIR=""
export DOMAIN="news.hackerlife.fun"

exec "$SCRIPT_DIR/deploy_core.sh" "$@"
